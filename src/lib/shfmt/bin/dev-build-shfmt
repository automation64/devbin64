source ./bin/dev-set &&
  source ./bin/dev-source-base &&
  source ./bin/dev-env-shfmt || exit 1

declare MY_SOURCE=''
declare MY_TARGET=''

function my_build() {
  bl64_dbg_app_show_function
  bl64_msg_show_task 'copy source file to staging area'
  bl64_fs_run_cp \
    -f \
    "$MY_SOURCE" "$MY_TARGET" &&
    bl64_msg_show_task 'build simplified version' &&
    "$DEV_LIB_SHFMT_BIN" \
      --minify \
      --write \
      "$MY_TARGET"
}

function my_initialize() {
  bl64_dbg_app_show_function
  MY_SOURCE="${DEV_BUILD_SHFMT_PATH_SOURCE}/${DEV_BUILD_SHFMT_SCRIPT_SOURCE}"
  MY_TARGET="${DEV_BUILD_SHFMT_PATH_TARGET}/${DEV_BUILD_SHFMT_SCRIPT_TARGET}"
  dev_base_task_initialize &&
    dev_base_lib_check_command 'shfmt' "$DEV_LIB_SHFMT_BIN" &&
    dev_base_build_setup "$DEV_BUILD_SHFMT_PATH_TARGET" &&
    bl64_check_export 'DEV_BUILD_SHFMT_SCRIPT_SOURCE' &&
    bl64_check_export 'DEV_BUILD_SHFMT_SCRIPT_TARGET' &&
    bl64_check_file "$MY_SOURCE" &&
    dev_base_task_show_setup \
      'DEV_BUILD_SHFMT_PATH_SOURCE' \
      'DEV_BUILD_SHFMT_PATH_TARGET' \
      'DEV_BUILD_SHFMT_SCRIPT_SOURCE' \
      'DEV_BUILD_SHFMT_SCRIPT_TARGET'
}

bl64_lib_script_version_set '1.0.0'
bl64_msg_help_set_about 'Build application in staging area'
dev_base_initialize && my_initialize || exit $?

bl64_msg_show_batch_start "$BL64_SCRIPT_ID"
my_build
bl64_msg_show_batch_finish $? "$BL64_SCRIPT_ID"
